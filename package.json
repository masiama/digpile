{
  "name": "digpile",
  "version": "1.0.0",
  "description": "Dig a random link out of your bookmark pile",
  "keywords": [
    "bookmarks",
    "chrome",
    "cli",
    "firefox",
    "productivity",
    "random"
  ],
  "homepage": "github:masiama/digpile",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masiama/digpile.git"
  },
  "bin": {
    "digpile": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "start": "node ./src/index.ts",
    "start:dist": "node ./dist/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@commander-js/extra-typings": "^14.0.0",
    "better-sqlite3": "12.10.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "jsdom": "^29.1.1",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.7.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
